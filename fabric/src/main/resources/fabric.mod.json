{
  "schemaVersion": 1,
  "id": "${archives_base_name}",
  "version": "${mod_version}",

  "name": "CC:C Bridge",
  "description": "This mod adds compatibility between the ComputerCraft and Create mod!\n\nCopyright ${copyright_year} Sammy L. Koch",
  "authors": ["Sammy L. Koch"],
  "contributors": [
    "agnor99",
    "Luke A. Hanssen",
    "Rikaisan",
    "Aspenhart",
    "pernydev",
    "TheZoidMaster",
    "Michael Bartosh"
  ],
  "contact": {
    "homepage": "https://cccbridge.kleinbox.dev/",
    "sources": "https://github.com/tweaked-programs/cccbridge",
    "issues": "https://github.com/tweaked-programs/cccbridge/issues"
  },

  "license": "${license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": ["cc.tweaked_programs.cccbridge.common.modloader.CCCBridge"],
    "client": [
      "cc.tweaked_programs.cccbridge.client.modloader.CCCBridgeClient"
    ],
    "modmenu": [
      "cc.tweaked_programs.cccbridge.client.optional_dependencies.ModMenuApiImpl"
    ]
  },
  "mixins": ["cccbridge.mixins.json"],

  "depends": {
    "create": "^${create_version_production}",
    "computercraft": ">=${cc_version}",
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "~${mc_version}",
    "java": ">=17"
  },
  "recommends": {
    "modmenu": "*"
  }
}
